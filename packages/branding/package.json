{
  "name": "@nxtqr/branding",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:social": "tsx scripts/generate-social.ts",
    "generate:all": "tsx scripts/generate-all.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nxtqr/design-system": "workspace:*",
    "@nxtqr/utils": "workspace:*"
  },
  "devDependencies": {
    "@nxtqr/typescript-config": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}

