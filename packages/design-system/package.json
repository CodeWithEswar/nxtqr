{
  "name": "@nxtqr/design-system",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./themes": "./src/themes/index.ts",
    "./typography": "./src/typography/index.ts",
    "./motion": "./src/motion/index.ts",
    "./accessibility": "./src/accessibility/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@nxtqr/shared-types": "workspace:*",
    "@nxtqr/validation": "workspace:*"
  },
  "devDependencies": {
    "@nxtqr/typescript-config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
