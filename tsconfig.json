{
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nxtqr/ui": ["packages/ui/src"],
      "@nxtqr/ui/*": ["packages/ui/src/*"],
      "@nxtqr/design-system": ["packages/design-system/src"],
      "@nxtqr/design-system/*": ["packages/design-system/src/*"],
      "@nxtqr/icons": ["packages/icons/src"],
      "@nxtqr/icons/*": ["packages/icons/src/*"],
      "@nxtqr/shared-types": ["packages/shared-types/src"],
      "@nxtqr/shared-types/*": ["packages/shared-types/src/*"],
      "@nxtqr/validation": ["packages/validation/src"],
      "@nxtqr/validation/*": ["packages/validation/src/*"],
      "@nxtqr/database": ["packages/database/src"],
      "@nxtqr/database/*": ["packages/database/src/*"],
      "@nxtqr/auth": ["packages/auth/src"],
      "@nxtqr/auth/*": ["packages/auth/src/*"],
      "@nxtqr/api-client": ["packages/api-client/src"],
      "@nxtqr/api-client/*": ["packages/api-client/src/*"],
      "@nxtqr/query": ["packages/query/src"],
      "@nxtqr/query/*": ["packages/query/src/*"],
      "@nxtqr/state": ["packages/state/src"],
      "@nxtqr/state/*": ["packages/state/src/*"],
      "@nxtqr/canvas-core": ["packages/canvas-core/src"],
      "@nxtqr/canvas-core/*": ["packages/canvas-core/src/*"],
      "@nxtqr/graph-schema": ["packages/graph-schema/src"],
      "@nxtqr/graph-schema/*": ["packages/graph-schema/src/*"],
      "@nxtqr/node-registry": ["packages/node-registry/src"],
      "@nxtqr/node-registry/*": ["packages/node-registry/src/*"],
      "@nxtqr/simulation-core": ["packages/simulation-core/src"],
      "@nxtqr/simulation-core/*": ["packages/simulation-core/src/*"],
      "@nxtqr/execution-trace": ["packages/execution-trace/src"],
      "@nxtqr/execution-trace/*": ["packages/execution-trace/src/*"],
      "@nxtqr/analytics": ["packages/analytics/src"],
      "@nxtqr/analytics/*": ["packages/analytics/src/*"],
      "@nxtqr/security": ["packages/security/src"],
      "@nxtqr/security/*": ["packages/security/src/*"],
      "@nxtqr/observability": ["packages/observability/src"],
      "@nxtqr/observability/*": ["packages/observability/src/*"],
      "@nxtqr/performance": ["packages/performance/src"],
      "@nxtqr/performance/*": ["packages/performance/src/*"],
      "@nxtqr/utils": ["packages/utils/src"],
      "@nxtqr/utils/*": ["packages/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
